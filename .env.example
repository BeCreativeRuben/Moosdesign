# Database (Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mollie (test_… or live_…)
MOLLIE_API_KEY=

# Legacy Stripe (unused — checkout uses Mollie)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Moosdesign <mowgli@moos-design.be>
ADMIN_EMAIL=mowgli@moos-design.be

# Vercel Blob (file uploads)
BLOB_READ_WRITE_TOKEN=

# Public site (optional; used for Mollie webhookUrl)
NEXT_PUBLIC_SITE_URL=https://moosdesign.be
NEXT_PUBLIC_CONTACT_PHONE=
